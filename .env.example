# Vector Flow — example environment file (m47).
# Copy to .env and fill in the real values. Never commit a filled-in
# .env, and never paste real values into chat or a screenshot.
# Every value below is intentionally empty.

# PostgreSQL connection string (Neon).
DATABASE_URL=
# Direct PostgreSQL connection string, no pooler (used by Prisma for migrations).
DIRECT_URL=

# Google sign-in (Google Cloud OAuth client for the club account).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign session tokens.
JWT_SECRET=
# Shared secret that protects the cron endpoints (constant-time checked).
CRON_SECRET=

# Cloudinary (image uploads: posters, QR codes, certificates, photos).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public base URL of the deployed site, e.g. https://vector-flow-club.vercel.app
APP_URL=

# Address mail is sent from.
MAIL_FROM=
# Google Group that receives event announcements for all students.
STUDENTS_GROUP_EMAIL=
# Gmail API refresh token for the club mailbox (mail goes through the Gmail API).
GMAIL_REFRESH_TOKEN=

# SMTP fallback only — Gmail API is the live transport, and SMTP is
# blocked for the club mailbox, so do not rely on these.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
